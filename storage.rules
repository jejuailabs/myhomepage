rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{allPaths=**} {
      // 홈피 이미지/음원은 공개 열람
      allow read: if true;

      // 본인만 업로드. 이미지 8MB / 오디오 15MB 제한
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size < 15 * 1024 * 1024)
        );
    }
  }
}
