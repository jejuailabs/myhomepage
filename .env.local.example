# Firebase Web SDK 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹앱)
# 이 값들은 클라이언트에 노출되는 공개 키입니다. 보안은 Firestore/Storage Rules로 확보합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase 미설정 상태에서도 UI 확인이 가능하도록 목업 데이터로 동작시킵니다.
# 실제 연동 후에는 false 로 두거나 제거하세요.
NEXT_PUBLIC_USE_MOCK=true

# 셀카 -> 프로필 사진 생성 (서버 전용, NEXT_PUBLIC_ 금지)
OPENAI_API_KEY=
