rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // 허브 카드는 비로그인 사용자도 봐야 하므로 읽기는 공개
      allow read: if true;

      // 최초 로그인 시 본인 문서 생성. 승인 절차 없이 바로 쓸 수 있도록 approved 로 만든다.
      // 단 role 은 스스로 admin 으로 올릴 수 없다.
      allow create: if isSelf(uid)
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'approved';

      // 본인은 표시 이름/슬러그만, 승인·역할·정렬은 관리자만
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.order == resource.data.order);

      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      // 주의: visibility == 'private' 은 화면에서 텍스트를 블러 처리하는 표현상의 장치일 뿐,
      // 이 규칙에서는 여전히 문서를 공개로 읽을 수 있다(허브 카드/사진 노출을 위해 필요).
      // 실제로 남이 못 읽게 막으려면 비공개 필드를 별도 서브컬렉션으로 분리하고
      // 그 경로에 `allow read: if isSelf(uid) || isAdmin();` 을 적용해야 한다.
      allow read: if true;
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
